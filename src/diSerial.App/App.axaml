<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:DiSerial.App.Converters"
             xmlns:dialogs="using:DiSerial.App.ViewModels.Dialogs"
             x:Class="DiSerial.App.App"
             Name="diSerial"
             RequestedThemeVariant="Default">



    <Application.Resources>
        <conv:ChannelToBrushConverter x:Key="ChannelToBrush" />
        <conv:FrameAccentToBrushConverter x:Key="AccentToBrush" />
        <conv:SentVisibilityConverter x:Key="SentVisible" />
        <conv:FrameRowBackgroundConverter x:Key="RowBackground" />
        <conv:BoolToThicknessConverter x:Key="InjectionBorder" />
        <conv:ControlLineStateConverter x:Key="ControlLine" />

        <DataTemplate x:Key="SessionTypeRow" DataType="dialogs:SessionTypeItem">
            <Button Classes="sessionRow" Command="{Binding Choose}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0" Classes="sessionRowIcon" Data="{Binding Icon}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding HasRequirement}"
                                   Text="{Binding Requirement}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Border.toolbar">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>

        <Style Selector="Path.toolbarIcon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.iconGo">
            <Setter Property="Stroke" Value="#1D9E75" />
            <Setter Property="Fill" Value="#1D9E75" />
        </Style>
        <Style Selector="Path.iconStop">
            <Setter Property="Stroke" Value="#D13438" />
            <Setter Property="StrokeThickness" Value="1.8" />
        </Style>
        <Style Selector="TabControl.settings">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Thumb.panelSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" VerticalAlignment="Stretch">
                        <Border Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabControl.panels">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabControl.panels > TabItem">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0,0,4,4" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TabControl.panels > TabItem:selected">
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#B06A00" />
        </Style>

        <Style Selector="TextBlock.err">
            <Setter Property="Foreground" Value="#B22222" />
        </Style>

        <Style Selector="TabControl.settings > TabItem">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Border.tabPane">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,4,4,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,-1,0,0" />
        </Style>

        <Style Selector="Path.iconClear">
            <Setter Property="Stroke" Value="#C77700" />
        </Style>
        <Style Selector="Path.iconPause">
            <Setter Property="Stroke" Value="#4B5EAA" />
        </Style>
        <Style Selector="Path.iconExport">
            <Setter Property="Stroke" Value="#0E7C86" />
        </Style>
        <Style Selector="Button:disabled Path.toolbarIcon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>

        <Style Selector="TextBox.lockable[IsReadOnly=True]">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style Selector="Button.sessionRow">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.sessionRow:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.sessionRow:pressed /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Path.sessionRowIcon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
        </Style>
    </Application.Styles>
</Application>
