<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DiSerial.App</RootNamespace>
    <AssemblyName>diSerial</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets\diserial.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Compile Remove="Build\**\*.cs" />
  </ItemGroup>

  <UsingTask TaskName="NormalizeWindowsDebugPaths"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyFile ParameterType="System.String" Required="true" />
      <RepositoryRoot ParameterType="System.String" Required="true" />
      <BuildTasksAssembly ParameterType="System.String" Required="true" />
      <References ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(AvaloniaBuildTasksLocation)" />
      <Code Type="Class" Language="cs" Source="$(MSBuildProjectDirectory)/Build/NormalizeWindowsDebugPaths.cs" />
    </Task>
  </UsingTask>
  <Target Name="NormalizeWindowsPackageDebugPaths"
          AfterTargets="CompileAvaloniaXaml"
          BeforeTargets="_CreateAppHost;GenerateSingleFileBundle"
          Condition="'$(DiSerialPackagedBuild)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <NormalizeWindowsDebugPaths AssemblyFile="@(IntermediateAssembly)"
                                RepositoryRoot="$(MSBuildProjectDirectory)/../.."
                                BuildTasksAssembly="$(AvaloniaBuildTasksLocation)"
                                References="@(ReferencePathWithRefAssemblies)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DiSerial.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="diserial.dev.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <PropertyGroup>
    <DiSerialPackagedBuild Condition="'$(DiSerialPackagedBuild)' == ''">false</DiSerialPackagedBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DiSerial.PackagedBuild" Value="$(DiSerialPackagedBuild)" />
  </ItemGroup>

  <Target Name="CheckPackagedBuildFlagBeforePublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(DiSerialPackagedBuild)' != 'true'"
           Text="DiSerialPackagedBuild is '$(DiSerialPackagedBuild)', so this build would still honour the command-line developer switch. Publish with tools/publish.ps1, which passes -p:DiSerialPackagedBuild=true." />
  </Target>

  <Target Name="CheckDeveloperSwitchesBeforePublish" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <_DevJsonPath>$(MSBuildProjectDirectory)\diserial.dev.json</_DevJsonPath>
      <_DevJsonText Condition="Exists('$(_DevJsonPath)')">$([System.IO.File]::ReadAllText('$(_DevJsonPath)'))</_DevJsonText>
      <_DevJsonPacked>$([System.Text.RegularExpressions.Regex]::Replace('$(_DevJsonText)', '\s', ''))</_DevJsonPacked>
    </PropertyGroup>
    <Error Condition="$(_DevJsonPacked.Contains('&quot;debugMode&quot;:true'))"
           Text="diserial.dev.json still has debugMode: true. A published build must not ship developer form - it would show SIMULATED data as if it were real bus traffic. Set it to false and publish again." />
  </Target>


  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' AND '$(MasStaticLibDir)' != ''">
    <LinkerArg Include="-L$(MasStaticLibDir)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />

    <PackageReference Include="Serilog" Version="$(SerilogVersion)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="$(SerilogExtensionsLoggingVersion)" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="$(SerilogFormattingCompactVersion)" />
    <PackageReference Include="Serilog.Sinks.Async" Version="$(SerilogSinksAsyncVersion)" />
    <PackageReference Include="Serilog.Sinks.File" Version="$(SerilogSinksFileVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\diSerial.Core\diSerial.Core.csproj" />
    <ProjectReference Include="..\diSerial.Infrastructure\diSerial.Infrastructure.csproj" />
  </ItemGroup>

</Project>
