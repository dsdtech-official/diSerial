<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sessions="using:DiSerial.App.ViewModels.Sessions"
             xmlns:views="using:DiSerial.App.Views.Panels"
             xmlns:icons="using:DiSerial.App.Views"
             xmlns:loc="using:DiSerial.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="560"
             x:Class="DiSerial.App.Views.Sessions.MonitorSessionView"
             x:DataType="sessions:MonitorSessionViewModel">


  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="toolbar">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
        <Button Command="{Binding ToggleConnectionCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon" Classes.iconGo="{Binding !IsConnected}"
                  Classes.iconStop="{Binding IsConnected}"
                  Data="{Binding ConnectionButtonIcon}" />
            <TextBlock Text="{Binding ConnectionButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <Button Command="{Binding ClearCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon iconClear" Data="{x:Static icons:ToolbarIcons.Clear}" />
            <TextBlock Text="{loc:Translate Toolbar.Clear}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding TogglePauseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon iconPause" Data="{Binding PauseButtonIcon}" />
            <TextBlock Text="{Binding PauseButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ToggleRecordCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon" Classes.iconStop="{Binding IsRecording}"
                  Data="{Binding RecordButtonIcon}" />
            <TextBlock Text="{Binding RecordButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon iconExport" Data="{x:Static icons:ToolbarIcons.Export}" />
            <TextBlock Text="{loc:Translate Toolbar.Export}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <Button>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="toolbarIcon" Data="{x:Static icons:ToolbarIcons.DisplaySettings}" />
            <TextBlock Text="{loc:Translate Toolbar.DisplaySettings}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="10" Margin="4" MinWidth="220">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="{loc:Translate Toolbar.Display}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding LogPanel.DisplayFormatChoices}"
                            SelectedValue="{Binding LogPanel.DisplayFormat}"
                            SelectedValueBinding="{Binding Value}"
                            DisplayMemberBinding="{Binding DisplayName}" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="{loc:Translate Toolbar.Timestamp}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding LogPanel.TimestampModeChoices}"
                            SelectedValue="{Binding LogPanel.TimestampMode}"
                            SelectedValueBinding="{Binding Value}"
                            DisplayMemberBinding="{Binding DisplayName}" />
                </StackPanel>

                <CheckBox Content="{loc:Translate Toolbar.ShowChannel}"
                          IsChecked="{Binding LogPanel.ShowChannelColumn}" />
                <CheckBox Content="{loc:Translate Toolbar.ShowDelta}"
                          IsChecked="{Binding LogPanel.ShowDeltaColumn}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Left" MinWidth="180" MaxWidth="260" Padding="10"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="caption" Text="{loc:Translate Channel.Header}" />

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="3" Height="14" Background="#378ADD" />
            <TextBlock Classes="mono" Text="{Binding ChannelA.PortName}" />
          </StackPanel>
          <TextBox Text="{Binding ChannelA.Alias}" PlaceholderText="{Binding ChannelA.AliasPlaceholder}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="3" Height="14" Background="#1D9E75" />
            <TextBlock Classes="mono" Text="{Binding ChannelB.PortName}" />
          </StackPanel>
          <TextBox Text="{Binding ChannelB.Alias}" PlaceholderText="{Binding ChannelB.AliasPlaceholder}" />
        </StackPanel>


        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <StackPanel Spacing="2">
          <TextBlock Classes="caption" Text="{loc:Translate Channel.BytesReceived}" />
          <TextBlock Classes="mono" Text="{Binding ChannelA.BytesReceived, StringFormat='A  {0}'}" />
          <TextBlock Classes="mono" Text="{Binding ChannelB.BytesReceived, StringFormat='B  {0}'}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <views:SendPanelView DockPanel.Dock="Bottom" />

    <views:LogPanelView DataContext="{Binding LogPanel}" />

  </DockPanel>
</UserControl>
