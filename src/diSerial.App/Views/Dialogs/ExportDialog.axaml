<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:DiSerial.App.ViewModels.Dialogs"
        xmlns:loc="using:DiSerial.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360"
        x:Class="DiSerial.App.Views.Dialogs.ExportDialog"
        x:DataType="dialogs:ExportDialogViewModel"
        Title="{loc:Translate Dialog.Export.Title}"
        Width="620" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="16">

    <TextBlock Text="{loc:Translate Dialog.Export.Title}" FontSize="16" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Dialog.Export.Format}"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding FormatChoices}"
                SelectedValue="{Binding Format}"
                SelectedValueBinding="{Binding Value}"
                DisplayMemberBinding="{Binding DisplayName}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Toolbar.Display}"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding DisplayFormatChoices}"
                SelectedValue="{Binding DisplayFormat}"
                SelectedValueBinding="{Binding Value}"
                DisplayMemberBinding="{Binding DisplayName}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Toolbar.Timestamp}"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding TimestampModeChoices}"
                SelectedValue="{Binding TimestampMode}"
                SelectedValueBinding="{Binding Value}"
                DisplayMemberBinding="{Binding DisplayName}" />
    </Grid>

    <StackPanel Spacing="6">
      <CheckBox Content="{loc:Translate Toolbar.ShowChannel}" IsChecked="{Binding IncludeChannelColumn}" />
      <CheckBox Content="{loc:Translate Toolbar.ShowDelta}" IsChecked="{Binding IncludeDeltaColumn}" />
    </StackPanel>

    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <StackPanel Spacing="6">
      <TextBlock Text="{loc:Translate Dialog.Export.SaveTo}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <!-- ⚠️ 路径很长，必须限死宽度：只写 MinWidth + SizeToContent 时
             TextBox 会按内容撑开，把整个对话框拉到主窗口那么宽（实测撞过）。 -->
        <TextBox Grid.Column="0" Text="{Binding FilePath}" TextWrapping="NoWrap" />
        <Button Grid.Column="1" Content="{loc:Translate Dialog.Export.Browse}"
                Command="{Binding BrowseCommand}" />
      </Grid>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{loc:Translate Common.Cancel}" Command="{Binding CancelCommand}" />
      <Button Content="{loc:Translate Dialog.Export.Confirm}" IsDefault="True"
              Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
